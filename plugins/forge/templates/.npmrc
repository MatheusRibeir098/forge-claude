# Copie este .npmrc para a raiz de cada projeto gerado.
# Conveniências de dev que reduzem atrito com pnpm.
auto-install-peers=true
strict-peer-dependencies=false

# NOTA: a pré-aprovação de build scripts nativos (better-sqlite3, esbuild, ...) NÃO é feita
# aqui. Ela vai no package.json do projeto:
#   "pnpm": { "onlyBuiltDependencies": ["better-sqlite3", "esbuild"] }
# Isso evita o comando interativo `pnpm approve-builds`. Ver skill `scaffolding`.
